        <mxCell id="iZrGjXHAwco_2WNDM7YZ-12" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" value="&lt;b&gt;Sample Evidences&lt;/b&gt;" vertex="1">
